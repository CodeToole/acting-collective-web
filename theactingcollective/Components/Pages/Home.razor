@* ============================================================================
   Home.razor  &mdash;  STATIC render (no @rendermode here).
   The page itself is static/SEO-friendly. Only the <RegistrationForm/> below
   is an interactive island via @rendermode="InteractiveServer".

   PORTING NOTE: paste the section markup from your existing index.html between
   the marked comments. It's plain HTML, so it drops straight in. I've kept the
   hero + register wrapper here to show the pattern; copy the rest (upcoming,
   pathway, about, films, instructors, faq, footer) verbatim from index.html.
   Only two things change vs. the static file:
     1. The <form id="registerForm"> block is REPLACED by <RegistrationForm/>.
     2. Nav/FAQ/film JS is replaced by Blazor later (Step 5) &mdash; static markup
        renders fine without it for now.
   ============================================================================ *@

@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using theactingcollective.Components.Shared
@using theactingcollective.Services
@inject IEventScheduleService Schedule

<PageTitle>The Acting Collective &mdash; Powered by Ziare</PageTitle>

<HeadContent>
    <meta name="description" content="The Acting Collective: hands-on acting training and filmmaker talent development in Mobile, Alabama. Powered by Ziare Perryman (Push). Reserve your spot for August 30, 2026." />
</HeadContent>

@* ---------- HERO ---------- *@
<section class="hero" id="home">
    <div class="container hero__inner">
        <p class="eyebrow">Powered by Ziare</p>
        <h1>The Acting<br />Collective</h1>
        <p class="hero__tag">A direct pipeline from training to real film credits.</p>

        <div class="hero__meta">
            <div class="hero__meta-item">
                <div>
                    <span class="label">Date &amp; Time</span>
                    <span class="value">August 30, 2026 &middot; 6:00&ndash;9:00 PM</span>
                </div>
            </div>
            <div class="hero__meta-item">
                <div>
                    <span class="label">Location</span>
                    <span class="value">350 N Broad St., Suite A &middot; Mobile, AL</span>
                </div>
            </div>
            <div class="hero__meta-item">
                <div>
                    <span class="label">Format</span>
                    <span class="value">In-person immersive session</span>
                </div>
            </div>
            @if (_isOpen)
            {
                <div class="hero__meta-item">
                    <div>
                        <span class="label">Registration Closes In</span>
                        <span class="value" style="color: var(--gold); font-family: 'SFMono-Regular', ui-monospace, monospace;">
                            @($"{_timeRemaining.Days}d {_timeRemaining.Hours:D2}h {_timeRemaining.Minutes:D2}m {_timeRemaining.Seconds:D2}s")
                        </span>
                    </div>
                </div>
            }
            else
            {
                <div class="hero__meta-item">
                    <div>
                        <span class="label">Status</span>
                        <span class="value" style="color: var(--gold-soft);">Registration Closed</span>
                    </div>
                </div>
            }
        </div>

        <div class="hero__cta">
            @if (_isOpen)
            {
                <a href="#register" class="btn btn--gold">Reserve Your Spot &rarr;</a>
            }
            else
            {
                <a href="#waitlist" class="btn btn--gold">Join Next Class Waitlist &rarr;</a>
            }
            <a href="#experience" class="btn btn--ghost">Explore the Experience</a>
        </div>
    </div>
</section>

@* ========================================================================
   PASTE FROM index.html HERE:
     #upcoming, #experience (pathway), #about, #films, #instructors
   They are plain static HTML &mdash; copy them verbatim.
   ======================================================================== *@

@if (_isOpen)
{
    @* ---------- REGISTRATION ---------- *@
    <section class="section register" id="register">
        <div class="container">
            <RegistrationForm />
        </div>
    </section>
}
else
{
    @* ---------- COMING SOON & WAITLIST ---------- *@
    <section class="section register" id="waitlist">
        <div class="container">
            <div class="form-panel">
                <p class="eyebrow" style="text-align:center;">[ Next Session ]</p>
                <h2>Class Coming Soon</h2>
                <p class="sub">
                    Registration for the current session is now closed. Join our waitlist to be first in line when Ziare announces his next class and exclusive workshop dates.
                </p>
                <NewsletterForm />
            </div>
        </div>
    </section>
}

@* ========================================================================
   PASTE FROM index.html HERE: #faq section (static markup is fine for now)
   ======================================================================== *@

@code {
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;
    private TimeSpan _timeRemaining;
    private bool _isOpen;

    protected override void OnInitialized()
    {
        _isOpen = Schedule.RegistrationIsOpen;
        _timeRemaining = Schedule.TimeRemaining;

        if (_isOpen)
        {
            _cts = new CancellationTokenSource();
            _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            _ = RunTimerAsync(_cts.Token);
        }
    }

    private async Task RunTimerAsync(CancellationToken token)
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(token))
            {
                var wasOpen = _isOpen;
                _isOpen = Schedule.RegistrationIsOpen;
                _timeRemaining = Schedule.TimeRemaining;

                await InvokeAsync(StateHasChanged);

                if (!_isOpen && wasOpen)
                {
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when component is disposed
        }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _timer?.Dispose();
    }
}


